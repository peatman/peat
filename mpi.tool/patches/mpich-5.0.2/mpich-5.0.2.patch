+/* public, unchecked size query that also works for internal (MPIR_*) datatypes */
+int mpi_internal_type_size(MPI_Datatype datatype, MPI_Aint * size)
+{
+    int mpi_errno = MPI_SUCCESS;
+
+    MPIR_Datatype_get_size_macro(datatype, *size);
+    MPIR_Assert(*size >= 0);
+
+    return mpi_errno;
+}
+
+int mpi_internal_type_size_x(MPI_Datatype datatype, MPI_Count * size)
+{
+    int mpi_errno = MPI_SUCCESS;
+
+    MPIR_Datatype_get_size_macro(datatype, *size);
+
+    return mpi_errno;
+}
