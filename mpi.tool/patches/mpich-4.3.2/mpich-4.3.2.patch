+int mpi_internal_comm_translate_rank(MPIR_Comm *comm, int rank)
+{
+    int  rank_out=MPI_UNDEFINED;
+//    if (rank ==  comm->rank) return rank;
+    if (rank < 0 ||  comm == NULL ) return MPI_UNDEFINED;
+    if (comm->comm_kind == MPIR_COMM_KIND__INTRACOMM) {
+        if (rank > comm->local_size || rank < 0) {
+           // fprintf (stderr,"(intracom): rank_in %d is out of bounds 0-%d\n",rank,comm->local_size);
+           return MPI_UNDEFINED;
+           // return rank;
+        }
+        // return local_group[rank]->rank;
+    }
+    if (comm->comm_kind == MPIR_COMM_KIND__INTERCOMM) {
+        if (rank > comm->remote_size || rank < 0) {
+            // fprintf (stderr,"(intercom): rank_in %d is out of bounds 0-%d\n",rank,comm->remote_size);
+            return MPI_UNDEFINED;
+            // return rank;
+        }
+        // return remote_group[rank]->rank;
+    }
+    if (comm->local_group != NULL ) {
+        MPIR_Group_translate_ranks_impl(comm->local_group, 1, &rank, MPIR_Process.comm_world->local_group,&rank_out);
+        if (rank_out==MPI_UNDEFINED) {
+        //     fprintf (stderr,"MPIR_Group_translate_ranks (local) failed %d,%d\n",rank,rank_out);
+        }
+    } else {
+       MPIR_Comm *parent_comm=comm->parent_comm;
+       if (parent_comm !=NULL) {
+           if(parent_comm->node_comm==comm) {
+               if(parent_comm->intranode_table_rev==NULL) {
+                   int i;
+                   parent_comm->intranode_table_rev=(int *)MPL_malloc(sizeof(int) * parent_comm->local_size, MPL_MEM_COLL);
+                   memset(parent_comm->intranode_table_rev,-1,sizeof(int) * parent_comm->local_size);
+                   for (i=0;i<parent_comm->local_size;i++) {
+                       if (parent_comm->intranode_table[i]>=0) {
+                           if (parent_comm->intranode_table_rev[parent_comm->intranode_table[i]]<0) {
+                               parent_comm->intranode_table_rev[parent_comm->intranode_table[i]]=i;
+                           }
+                       }
+                   }
+               }
+               // fprintf (stderr,"Recursive node %d,%d\n",rank,parent_comm->intranode_table_rev[rank]);
+               if (parent_comm->intranode_table_rev[rank] < 0) {
+                  // fprintf (stderr,"Recursive node (intranode_table_rev) is not initialized for %d,%d\n",rank,parent_comm->intranode_table_rev[rank]);
+               }
+               return mpi_internal_comm_translate_rank(parent_comm,parent_comm->intranode_table_rev[rank]);
+           }
+           if(parent_comm->node_roots_comm==comm) {
+               if(parent_comm->internode_table_rev==NULL) {
+                   int i;
+                   parent_comm->internode_table_rev=(int *)MPL_malloc(sizeof(int) * parent_comm->local_size, MPL_MEM_COLL);
+                   memset(parent_comm->internode_table_rev,-1,sizeof(int) * parent_comm->local_size);
+                   for (i=0;i<parent_comm->local_size;i++) {
+                       if (parent_comm->internode_table[i]>=0) {
+                           if (parent_comm->internode_table_rev[parent_comm->internode_table[i]]<0) {
+                               parent_comm->internode_table_rev[parent_comm->internode_table[i]]=i;
+                           }
+                       }
+                   }
+               }
+               // fprintf (stderr,"Recursive node roots %d,%d\n",rank,parent_comm->internode_table_rev[rank]);
+               if (parent_comm->internode_table_rev[rank] < 0) {
+                  // fprintf (stderr,"Recursive node roots (internode_table_rev) is not initialized for %d,%d\n",rank,parent_comm->internode_table_rev[rank]);
+               }
+               return mpi_internal_comm_translate_rank(parent_comm,parent_comm->internode_table_rev[rank]);
+           }
+       }
+    }
+
+    if (rank_out==MPI_UNDEFINED) {
+        if (comm->remote_group != NULL ) {
+            MPIR_Group_translate_ranks_impl(comm->remote_group, 1, &rank, MPIR_Process.comm_world->local_group,&rank_out);
+            if (rank_out==MPI_UNDEFINED) {
+                // fprintf (stderr,"MPIR_Group_translate_ranks (remote) failed %d,%d\n",rank,rank_out);
+            }
+        }
+    }
+    return rank_out;
+}
+
+void mpi_internal_print_comm_tree(MPIR_Comm *comm, int depth) {
+    if (depth==0) fprintf(stderr,"=========================================\n");
+    fprintf(stderr,"%*s current comm %p-%x - parent comm %p\n",depth*8," ", comm, comm->handle, comm->parent_comm);
+    if (comm->node_comm)  {
+        fprintf(stderr,"%*s Node comm\n",depth*8," ");
+        mpi_internal_print_comm_tree(comm->node_comm, depth+1);
+    }
+    if (comm->node_roots_comm) {
+        fprintf(stderr,"%*s Node root comm\n",depth*8," ");
+        mpi_internal_print_comm_tree(comm->node_roots_comm,depth+1);
+    }
+}
