+MPI_Request mpi_internal_get_request(MPIR_Request *request)
+{
+    /* lightweight/pre-completed requests (MPI_PROC_NULL sends/receives, and sends/receives that complete
+     * inline before the posting call returns, e.g. an eager send delivered directly into the receiver's
+     * shared-memory queue) share one of a handful of statically allocated MPIR_Request objects per kind
+     * instead of a real per-call request - see MPIR_Request_builtin / MPIR_REQUEST_COMPLETE in
+     * src/include/mpir_request.h. Every such call shares the same handle for its kind, so a tool matching
+     * by request value cannot tell two such completions apart; map them all to 0 instead - the tractor's
+     * own convention for "no request/invalid", distinct from MPI_REQUEST_NULL (0x2c000000 here). */
+    if (request->handle >= MPIR_REQUEST_COMPLETE && request->handle < MPIR_REQUEST_COMPLETE + MPIR_REQUEST_N_BUILTIN) {
+        return 0;
+    }
+    return request->handle;
+}
+
+int mpi_internal_get_requests(int inum, MPIR_Request **requests_in, MPI_Request *requests_out)
+{
+    int i;
+    for (i=0;i<inum;i++)  {
+        requests_out[i]=mpi_internal_get_request(requests_in[i]);
+    }
+    return 0;
+}
+
+MPIR_Comm* mpi_internal_get_comm(MPIR_Request *request)
+{
+    if(request->handle==MPI_REQUEST_NULL || request->kind != MPIR_REQUEST_KIND__RECV) {
+        return NULL;
+    } else {
+        return request->comm;
+    }
+}
+
+int mpi_internal_get_comms(int inum,MPIR_Request **requests_in, MPIR_Comm **comms_out)
+{
+    int i;
+    for (i=0;i<inum;i++)  {
+        if(requests_in[i]->handle==MPI_REQUEST_NULL || requests_in[i]->kind != MPIR_REQUEST_KIND__RECV) {
+            comms_out[i]=NULL;
+        } else {
+            comms_out[i]=requests_in[i]->comm;
+        }
+    }
+    return 0;
+}
+
+MPI_Comm mpi_internal_get_comm_handle_from_comm(MPIR_Comm *comm)
+{
+    if (comm == NULL) return MPI_COMM_NULL;
+    return comm->handle;
+}
