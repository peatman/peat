+    MPI_INTERNAL_COMM__LOCALCOMM = 1,        /* intercomm->local_comm */
+    MPI_INTERNAL_COMM__NODE_COMM,            /* comm->node_comm */
+    MPI_INTERNAL_COMM__NODE_ROOTS_COMM,      /* comm->node_roots_comm */
+    MPI_INTERNAL_COMM__MULTI_LEADS_COMM,     /* ch4 MPIDI_COMM(comm, multi_leads_comm) */
+    MPI_INTERNAL_COMM__INTER_NODE_LEADS_COMM,/* ch4 MPIDI_COMM(comm, inter_node_leads_comm) */
+    MPI_INTERNAL_COMM__SUB_NODE_COMM,        /* ch4 MPIDI_COMM(comm, sub_node_comm) */
+    MPI_INTERNAL_COMM__INTRA_NODE_LEADS_COMM,/* ch4 MPIDI_COMM(comm, intra_node_leads_comm) */
+    MPI_INTERNAL_COMM__BOOTSTRAP              /* e.g. MPIR_Comm_create_from_group_impl's new_comm: a
+                                               * top-level comm committed outside any public MPI_Comm_*
+                                               * entry point, so it has no parent_comm of its own */
+};
