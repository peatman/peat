+               if(parent_comm->intranode_table_rev==NULL) {
+                   int i;
+                   parent_comm->intranode_table_rev=(int *)MPL_malloc(sizeof(int) * parent_comm->local_size, MPL_MEM_COLL);
+                   memset(parent_comm->intranode_table_rev,-1,sizeof(int) * parent_comm->local_size);
+                   for (i=0;i<parent_comm->local_size;i++) {
+                       if (parent_comm->intranode_table[i]>=0) {
+                           if (parent_comm->intranode_table_rev[parent_comm->intranode_table[i]]<0) {
+                               parent_comm->intranode_table_rev[parent_comm->intranode_table[i]]=i;
+                           }
+                       }
+                   }
+               }
+               // fprintf (stderr,"Recursive node %d,%d\n",rank,parent_comm->intranode_table_rev[rank]);
+               if (parent_comm->intranode_table_rev[rank] < 0) {
+                  // fprintf (stderr,"Recursive node (intranode_table_rev) is not initialized for %d,%d\n",rank,parent_comm->intranode_table_rev[rank]);
+               }
+               return mpi_internal_comm_translate_rank(parent_comm,parent_comm->intranode_table_rev[rank]);
+           }
+           if(parent_comm->node_roots_comm==comm) {
+               if(parent_comm->internode_table_rev==NULL) {
+                   int i;
+                   parent_comm->internode_table_rev=(int *)MPL_malloc(sizeof(int) * parent_comm->local_size, MPL_MEM_COLL);
+                   memset(parent_comm->internode_table_rev,-1,sizeof(int) * parent_comm->local_size);
+                   for (i=0;i<parent_comm->local_size;i++) {
+                       if (parent_comm->internode_table[i]>=0) {
+                           if (parent_comm->internode_table_rev[parent_comm->internode_table[i]]<0) {
+                               parent_comm->internode_table_rev[parent_comm->internode_table[i]]=i;
+                           }
+                       }
+                   }
+               }
+               // fprintf (stderr,"Recursive node roots %d,%d\n",rank,parent_comm->internode_table_rev[rank]);
+               if (parent_comm->internode_table_rev[rank] < 0) {
+                  // fprintf (stderr,"Recursive node roots (internode_table_rev) is not initialized for %d,%d\n",rank,parent_comm->internode_table_rev[rank]);
+               }
+               return mpi_internal_comm_translate_rank(parent_comm,parent_comm->internode_table_rev[rank]);
+           }
+       }
+    }
+
+    if (rank_out==MPI_UNDEFINED) {
+        if (comm->remote_group != NULL ) {
+            MPIR_Group_translate_ranks_impl(comm->remote_group, 1, &rank, MPIR_Process.comm_world->local_group,&rank_out);
+            if (rank_out==MPI_UNDEFINED) {
+                // fprintf (stderr,"MPIR_Group_translate_ranks (remote) failed %d,%d\n",rank,rank_out);
+            }
+        }
+    }
+    return rank_out;
+}
+
+void mpi_internal_print_comm_tree(MPIR_Comm *comm, int depth) {
+    if (depth==0) fprintf(stderr,"=========================================\n");
+    fprintf(stderr,"%*s current comm %p-%x - parent comm %p\n",depth*8," ", comm, comm->handle, comm->parent_comm);
+    if (comm->node_comm)  {
+        fprintf(stderr,"%*s Node comm\n",depth*8," ");
+        mpi_internal_print_comm_tree(comm->node_comm, depth+1);
+    }
+    if (comm->node_roots_comm) {
+        fprintf(stderr,"%*s Node root comm\n",depth*8," ");
+        mpi_internal_print_comm_tree(comm->node_roots_comm,depth+1);
+    }
+}
+
+int mpi_internal_comm_translate_rank_verbose(MPIR_Comm *comm, int rank)
+{
+    int  rank_out=MPI_UNDEFINED;
+    fprintf (stderr,"Begin mpi_internal_comm_translate_rank_verbose for %x - %d\n",comm->handle, rank);
+//    if (rank ==  comm->rank) return rank;
+    if (comm->comm_kind == MPIR_COMM_KIND__INTRACOMM ) {
+        if (rank > comm->local_size || rank < 0) {
+           fprintf (stderr,"(%x intracom): rank_in %d is out of bounds 0-%d\n",comm->handle,rank,comm->local_size);
+           return MPI_UNDEFINED;
+           // return rank;
+        }
+        // return local_group[rank]->rank;
+    }
+    if (comm->comm_kind == MPIR_COMM_KIND__INTERCOMM ) {
+        if (rank > comm->remote_size || rank < 0) {
+            fprintf (stderr,"(%x intercom): rank_in %d is out of bounds 0-%d\n",comm->handle,rank,comm->remote_size);
+            return MPI_UNDEFINED;
+            // return rank;
+        }
+        // return remote_group[rank]->rank;
+    }
+    if (comm->local_group != NULL ) {
+        fprintf (stderr,"Doing MPIR_Group_translate_ranks (%x local) for %d\n",comm->handle,rank);
+        MPIR_Group_translate_ranks_impl(comm->local_group, 1, &rank, MPIR_Process.comm_world->local_group,&rank_out);
+        if (rank_out==MPI_UNDEFINED) {
+            fprintf (stderr,"MPIR_Group_translate_ranks (%x local) failed %d,%d\n",comm->handle,rank,rank_out);
+        }
+    } else {
+       MPIR_Comm *parent_comm=comm->parent_comm;
+       if (parent_comm !=NULL) {
+           if(parent_comm->node_comm==comm) {
+               if(parent_comm->intranode_table_rev==NULL) {
+                   int i;
+                   parent_comm->intranode_table_rev=(int *)MPL_malloc(sizeof(int) * parent_comm->local_size, MPL_MEM_COLL);
+                   memset(parent_comm->intranode_table_rev,-1,sizeof(int) * parent_comm->local_size);
+                   for (i=0;i<parent_comm->local_size;i++) {
+                       if (parent_comm->intranode_table[i]>=0) {
+                           if (parent_comm->intranode_table_rev[parent_comm->intranode_table[i]]<0) {
+                               parent_comm->intranode_table_rev[parent_comm->intranode_table[i]]=i;
+                           }
+                       }
+                   }
+               }
+               fprintf (stderr,"Recursive node %d,%d\n",rank,parent_comm->intranode_table_rev[rank]);
+               if (parent_comm->intranode_table_rev[rank] < 0) {
+                  fprintf (stderr,"Recursive node (intranode_table_rev) of %x is not initialized for %d,%d\n",comm->handle,rank,parent_comm->intranode_table_rev[rank]);
+               }
+               return mpi_internal_comm_translate_rank_verbose(parent_comm,parent_comm->intranode_table_rev[rank]);
+           }
+           if(parent_comm->node_roots_comm==comm) {
+               if(parent_comm->internode_table_rev==NULL) {
+                   int i;
+                   parent_comm->internode_table_rev=(int *)MPL_malloc(sizeof(int) * parent_comm->local_size, MPL_MEM_COLL);
+                   memset(parent_comm->internode_table_rev,-1,sizeof(int) * parent_comm->local_size);
+                   for (i=0;i<parent_comm->local_size;i++) {
+                       if (parent_comm->internode_table[i]>=0) {
+                           if (parent_comm->internode_table_rev[parent_comm->internode_table[i]]<0) {
+                               parent_comm->internode_table_rev[parent_comm->internode_table[i]]=i;
+                           }
+                       }
+                   }
+               }
+               fprintf (stderr,"Recursive node roots %x %d,%d\n",comm->handle,rank,parent_comm->internode_table_rev[rank]);
+               if (parent_comm->internode_table_rev[rank] < 0) {
+                  fprintf (stderr,"Recursive node roots (internode_table_rev) for %x is not initialized for %d,%d\n",comm->handle,rank,parent_comm->internode_table_rev[rank]);
+               }
+               return mpi_internal_comm_translate_rank_verbose(parent_comm,parent_comm->internode_table_rev[rank]);
+           }
+       }
+    }
+
+    if (rank_out==MPI_UNDEFINED) {
+        if (comm->remote_group != NULL ) {
+            fprintf (stderr,"Doing MPIR_Group_translate_ranks (%x remote) for %d\n",comm->handle,rank);
+            MPIR_Group_translate_ranks_impl(comm->remote_group, 1, &rank, MPIR_Process.comm_world->local_group,&rank_out);
+            if (rank_out==MPI_UNDEFINED) {
+                fprintf (stderr,"MPIR_Group_translate_ranks (%x remote) failed %d,%d\n",comm->handle,rank,rank_out);
+            }
+        }
+    }
+    fprintf (stderr,"End mpi_internal_comm_translate_rank_verbose for %d->%d\n",rank,rank_out);
+    if (rank_out==MPI_UNDEFINED) {
+        fprintf (stderr,"Rank not found comm=%p,%x. groups=%p,%p\n",comm,comm->handle,comm->local_group,comm->remote_group);
+        mpi_internal_print_comm_tree(comm,0);
+    } else {
+        fprintf (stderr,"Rank found comm=%p,%x. groups=%p,%p\n",comm,comm->handle,comm->local_group,comm->remote_group);
+        mpi_internal_print_comm_tree(comm,0);
+    }
+    return rank_out;
+}
+
+int mpi_internal_request_translate_rank(MPIR_Request *request, int rank)
+{
+    return mpi_internal_comm_translate_rank(request->comm,rank);
+}
+
+#ifdef CHANNEL_MRAIL
+extern MPID_Request *mv2_dummy_request;
+#endif
+
+MPI_Request mpi_internal_get_request(MPIR_Request *request)
+{
+#ifdef CHANNEL_MRAIL
+    if (request==mv2_dummy_request) return 0;
+#endif
+    return request->handle;
+}
+
+int mpi_internal_get_requests(int inum, MPIR_Request **requests_in, MPI_Request *requests_out)
+{
+    int i;
+    for (i=0;i<inum;i++)  {
+#ifdef CHANNEL_MRAIL
+        if (requests_in[i]==mv2_dummy_request) requests_out[i]=0; else 
+#endif
+        requests_out[i]=requests_in[i]->handle;
+    }
+    return 0;
+}
+
+MPI_Request MPI_Check_dummy(MPI_Request request)
+{
+#ifdef CHANNEL_MRAIL
+        if (request==mv2_dummy_request->handle) return 0;
+#endif
+    return request;
+}
+
+MPIR_Comm* mpi_internal_get_comm(MPIR_Request *request)
+{
+    if(request->handle==MPI_REQUEST_NULL || request->kind != MPIR_REQUEST_KIND__RECV) {
+        return NULL;
+    } else {
+        return request->comm;
+    }
+}
+
+int mpi_internal_get_comms(int inum,MPIR_Request **requests_in, MPIR_Comm **comms_out)
+{
+    int i;
+    for (i=0;i<inum;i++)  {
+        if(requests_in[i]->handle==MPI_REQUEST_NULL || requests_in[i]->kind != MPIR_REQUEST_KIND__RECV) {
+            comms_out[i]=NULL;
+        } else {
+            comms_out[i]=requests_in[i]->comm;
+        }
+    }
+    return 0;
+}
+
+MPI_Comm mpi_internal_get_mpicomm_from_mpidcomm(MPIR_Comm *comm)
+{
+    if (comm->parent_comm) return mpi_internal_get_mpicomm_from_mpidcomm(comm->parent_comm);
+    return comm->handle;
+}
