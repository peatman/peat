+/**
+ * Tell whether a request belongs to internal collective traffic: a
+ * nonblocking or persistent collective (OMPI_REQUEST_COLL) or a
+ * nonblocking communicator operation such as MPI_Comm_idup
+ * (OMPI_REQUEST_COMM).
+ *
+ * @param request (IN)  Request, may be MPI_REQUEST_NULL.
+ * @return              true for a collective or communicator request.
+ */
+static inline bool ompi_coll_p2p_request_is_internal(const struct ompi_request_t *request)
+{
+    return NULL != request &&
+           (OMPI_REQUEST_COLL == request->req_type ||
+            OMPI_REQUEST_COMM == request->req_type);
+}
+
+/**
+ * Tell whether any request of an array belongs to internal collective
+ * traffic.  The array forms of the MPI request bindings hand the whole
+ * array to the proxy in that case, so a mixed array (user
+ * point-to-point and collective requests) is completed by one call with
+ * unchanged semantics.
+ *
+ * @param count (IN)     Number of requests.
+ * @param requests (IN)  Requests, entries may be MPI_REQUEST_NULL.
+ * @return               true if at least one request is internal.
+ */
+static inline bool ompi_coll_p2p_any_request_is_internal(size_t count,
+                                                         struct ompi_request_t *const *requests)
+{
+    for (size_t i = 0; i < count; ++i) {
+        if (ompi_coll_p2p_request_is_internal(requests[i])) {
+            return true;
+        }
+    }
+    return false;
+}
