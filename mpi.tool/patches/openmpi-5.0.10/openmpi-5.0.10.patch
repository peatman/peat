+int mpi_internal_comm_translate_rank(const struct ompi_communicator_t *comm, int rank)
+{
+    opal_process_name_t name;
+
+    if (NULL == comm) {
+        return MPI_UNDEFINED;
+    }
+    if (NULL == comm->c_remote_group) {
+        return MPI_UNDEFINED;
+    }
+    if (rank < 0 || rank >= comm->c_remote_group->grp_proc_count) {
+//        return MPI_UNDEFINED;
+        return rank;  // wildcards should be returned unchanged
+    }
+    /* peer ranks index c_remote_group: the remote group of an intercommunicator,
+     * or the local group of an intracommunicator (c_remote_group == c_local_group).
+     * Do not use ompi_comm_remote_size(): it returns 0 for intracommunicators. */
+    name = ompi_group_get_proc_name(comm->c_remote_group, rank);
+    if (name.jobid != OMPI_PROC_MY_NAME->jobid) {
+        /* spawned or connected process: not part of my MPI_COMM_WORLD */
+        return MPI_UNDEFINED;
+    }
+    return (int) name.vpid;
+}
+
+int mpi_internal_comm_translate_rank_verbose(const struct ompi_communicator_t *comm, int rank)
+{
+    opal_process_name_t name;
+
+    if (NULL == comm) {
+        printf("comm is NULL, rank %d\n", rank);
+        return MPI_UNDEFINED;
+    }
+    if (NULL == comm->c_remote_group) {
+        printf("comm %p has no group (freed communicator or not a communicator?) rank %d\n",
+               (void *) comm, rank);
+        return MPI_UNDEFINED;
+    }
+    if (rank < 0 || rank >= comm->c_remote_group->grp_proc_count) {
+        printf("rank is out of bounds %p %d: %s%s%s name \"%s\" cid %u %s local size %d peer size %d\n",
+               (void *) comm, rank,
+               comm == &ompi_mpi_comm_world.comm ? "[MPI_COMM_WORLD]" : "",
+               comm == &ompi_mpi_comm_self.comm ? "[MPI_COMM_SELF]" : "",
+               comm == &ompi_mpi_comm_null.comm ? "[MPI_COMM_NULL]" : "",
+               NULL != comm->c_name ? comm->c_name : "",
+               comm->c_index,
+               OMPI_COMM_IS_INTER(comm) ? "inter" : "intra",
+               NULL != comm->c_local_group ? comm->c_local_group->grp_proc_count : -1,
+               comm->c_remote_group->grp_proc_count);
+//        return MPI_UNDEFINED;
+        return rank;  // wildcards should be returned unchanged
+    }
+    /* peer ranks index c_remote_group: the remote group of an intercommunicator,
+     * or the local group of an intracommunicator (c_remote_group == c_local_group).
+     * Do not use ompi_comm_remote_size(): it returns 0 for intracommunicators. */
+    name = ompi_group_get_proc_name(comm->c_remote_group, rank);
+    if (name.jobid != OMPI_PROC_MY_NAME->jobid) {
+        /* spawned or connected process: not part of my MPI_COMM_WORLD */
+        printf("spawned or connected process: not part of my MPI_COMM_WORLD %p %d\n",comm,rank);
+        return MPI_UNDEFINED;
+    }
+    return (int) name.vpid;
+}
+
+MPI_Comm mpi_internal_get_comm(MPI_Request request)
+{
+    if (NULL == request || MPI_REQUEST_NULL == request) {
+        return MPI_COMM_NULL;
+    }
+    /* req_mpi_object is a union selected by req_type */
+    switch (request->req_type) {
+    case OMPI_REQUEST_PML:
+    case OMPI_REQUEST_COLL:
+    case OMPI_REQUEST_COMM:
+    case OMPI_REQUEST_PART:
+        /* the communicator is NULL if the component did not record it */
+        return (NULL != request->req_mpi_object.comm)
+                   ? (MPI_Comm) request->req_mpi_object.comm : MPI_COMM_NULL;
+    default:    /* IO: file, WIN: win, GEN/NOOP/NULL: no MPI object */
+        return MPI_COMM_NULL;
+    }
+}
+
+int mpi_internal_get_comms(int inum, MPI_Request *requests_in, MPI_Comm *comms_out)
+{
+    int nresolved = 0;
+    int i;
+
+    if (inum < 0 || (inum > 0 && (NULL == requests_in || NULL == comms_out))) {
+        return MPI_UNDEFINED;
+    }
+    for (i = 0; i < inum; ++i) {
+        comms_out[i] = mpi_internal_get_comm(requests_in[i]);
+        if (MPI_COMM_NULL != comms_out[i]) {
+            ++nresolved;
+        }
+    }
+    return nresolved;
+}
+
+int mpi_internal_request_translate_rank(MPI_Request request, int rank)
+{
+    MPI_Comm comm = mpi_internal_get_comm(request);
+
+    if (MPI_COMM_NULL == comm) {
+        return MPI_UNDEFINED;
+    }
+    return mpi_internal_comm_translate_rank(comm, rank);
+}
