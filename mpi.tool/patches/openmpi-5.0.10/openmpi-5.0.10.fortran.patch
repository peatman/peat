 #include "ompi/mpi/fortran/base/fint_2_int.h"
 
+/*
+ * Runtime redirection of the Fortran bindings to the C MPI_* API.
+ *
+ * By default every Fortran wrapper calls PMPI_Xxx.  If the environment
+ * variable OMPI_FORTRAN_MPI_REDIRECT is set (to anything other than ""
+ * or "0"), the wrappers call MPI_Xxx instead, so that C-level PMPI
+ * tools also see the Fortran calls.  This applies to both the mpi_*
+ * and the pmpi_* Fortran entry points (mpif.h, "use mpi" and
+ * "use mpi_f08" all end up here).  Handle conversion helpers
+ * (PMPI_*_f2c / PMPI_*_c2f) are never redirected.
+ *
+ * A self-referencing object-like macro is not re-expanded, so the
+ * PMPI_Xxx on the right-hand side below is the real C function.
+ */
+#include <stdlib.h>
+
+static inline int ompi_fortran_mpi_redirect(void)
+{
+    /* one copy per translation unit; getenv() runs once per unit */
+    static int redirect = -1;
+    if (-1 == redirect) {
+        const char *e = getenv("OMPI_FORTRAN_MPI_REDIRECT");
+        redirect = (NULL != e && '\0' != e[0] &&
+                    !('0' == e[0] && '\0' == e[1])) ? 1 : 0;
+    }
+    return redirect;
+}
+
+#define PMPI_Abort (ompi_fortran_mpi_redirect() ? MPI_Abort : PMPI_Abort)
+#define PMPI_Accumulate (ompi_fortran_mpi_redirect() ? MPI_Accumulate : PMPI_Accumulate)
