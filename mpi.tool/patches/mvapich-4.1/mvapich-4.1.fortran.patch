diff -ruN a/src/include/mpii_fortran_redirect.h b/src/include/mpii_fortran_redirect.h
--- a/src/include/mpii_fortran_redirect.h
+++ b/src/include/mpii_fortran_redirect.h
@@ -0,0 +1,35 @@
+/*
+ * Runtime redirection of the Fortran bindings to the C MPI_* API.
+ *
+ * By default the Fortran wrappers (mpif.h, "use mpi" and "use mpi_f08")
+ * call PMPI_Xxx.  If the environment variable MVP_FORTRAN_MPI_REDIRECT is
+ * set (to anything other than "" or "0"), they call MPI_Xxx instead, so
+ * that C-level PMPI tools also see the Fortran calls.  Handle conversion
+ * helpers (MPI_*_f2c / MPI_*_c2f) are never redirected.
+ *
+ * The wrapper sources are not touched: mpi_fortimpl.h and cdesc.h define
+ * self-referencing macros of the form
+ *     #define MPI_Send (MPII_fortran_mpi_redirect() ? MPI_Send : PMPI_Send)
+ * An object-like macro is not re-expanded inside its own replacement
+ * list, so the MPI_Send on the right-hand side is the real C function.
+ * The mpi_f08 interfaces without buffer arguments bind to C directly and
+ * are routed through the MPIR_F08_* shims in wrappers_c/f08_redirect.c.
+ */
+#ifndef MPII_FORTRAN_REDIRECT_H_INCLUDED
+#define MPII_FORTRAN_REDIRECT_H_INCLUDED
+
+#include <stdlib.h>
+
+static inline int MPII_fortran_mpi_redirect(void)
+{
+    /* one copy per translation unit; getenv() runs once per unit */
+    static int redirect = -1;
+    if (-1 == redirect) {
+        const char *e = getenv("MVP_FORTRAN_MPI_REDIRECT");
+        redirect = (NULL != e && '\0' != e[0] &&
+                    !('0' == e[0] && '\0' == e[1])) ? 1 : 0;
+    }
+    return redirect;
+}
+
+#endif /* MPII_FORTRAN_REDIRECT_H_INCLUDED */
